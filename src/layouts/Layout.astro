---
import ClientRouter from 'astro/components/ClientRouter.astro';
import {SITE_DESCRIPTION, SITE_TITLE} from '../consts.ts';
import BaseHead from '../components/BaseHead.astro';
import Header from "../components/Header.astro";
import Footer from '../components/Footer.astro';
import {Font} from "astro:assets";
import '../styles/global.css';
import DeckToolbar from "../components/DeckToolbar.astro";

const props = Astro.props;
const nation = props.nation
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const matched = path.match(/[^\/]+/g)
---

<!doctype html>
<html lang="en">
<head>
    <BaseHead title={SITE_TITLE + " - " + props.title} description={SITE_DESCRIPTION}/>
    <Font cssVariable='--font-outfit'/>
    <Font cssVariable='--font-audiowide'/>
    <meta charset="UTF-8">
    <link href="/src/styles/showcase.css" rel="stylesheet" type="text/css"/>
    <!--TODO Update BeerCSS-->
    <link href="https://cdn.jsdelivr.net/npm/beercss@3.12.13/dist/cdn/beer.min.css" rel="stylesheet"/>
    <script type="module" src="https://cdn.jsdelivr.net/npm/beercss@3.12.13/dist/cdn/beer.min.js"></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/material-dynamic-colors@1.1.2/dist/cdn/material-dynamic-colors.min.js"></script>
    <script type="module" data-astro-rerun define:vars={{nation}}>
        // For some reason a direct import would not work here, so we're importing in head
        switch (nation) {
            case "Brandt Gate":
                ui("theme", "#abb3bf");
                break;
            case "Dragon Empire":
                ui("theme", "#c50017")
                break;
            case "Dark States":
                ui("theme", "#062c88")
                break;
            case "Stoicheia":
                ui("theme", "#007c36");
                break;
            case "Lyrical Monasterio":
                ui("theme", "#eb6c99");
                break;
            case "Keter Sanctuary":
                ui("theme", "#fcc600");
                break;
            default:
                ui("theme", "#039fec");
                break;
        }
    </script>
    <ClientRouter/>
</head>
<body>
<div style="display: flex; flex-direction: column; min-height: 100vh">
    <Header/>
    <div style="flex: 1">
        <slot />
    </div>
    {["prices", "decks"].includes(matched?.at(0) ?? "") && <DeckToolbar />}
    <Footer/>
</div>

</body>
</html>
